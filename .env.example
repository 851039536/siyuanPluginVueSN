# Siyuan workspace path
# The workspace contains `data` folder
VITE_SIYUAN_WORKSPACE_PATH=/path/to/siyuan/workspace

# Manually set the dist dir to work with Symbolic Links
VITE_DEV_DIST_DIR=

# 多环境用法：每个环境一个配置文件，通过 --mode 切换
# 例如：pnpm dev:test = vite build --watch --mode test，会加载 .env + .env.test
# 优先级：.env.[mode].local > .env.[mode] > .env.local > .env
# 示例：新建 .env.test，内容为 VITE_SIYUAN_WORKSPACE_PATH=/path/to/test/workspace
# 注意：多环境专用配置请放在 .env.<mode> 文件中，避免 .env.local 优先级更高导致覆盖