{
  "compilerOptions": {
    "target": "ESNext",
    "jsx": "preserve",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "useDefineForClassFields": true,
    "baseUrl": ".",
    "module": "ESNext",
    /* Bundler mode */
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"],
      "@/libs/*": ["./src/libs/*"],
      // 功能模块别名：@<featureName> → src/features/<featureName>，与 vite.config.ts alias 保持一致
      "@aiContentGenerator/*": ["./src/features/aiContentGenerator/*"],
      "@apiDebugger/*": ["./src/features/apiDebugger/*"],
      "@bookmarkMarker/*": ["./src/features/bookmarkMarker/*"],
      "@compactMode/*": ["./src/features/compactMode/*"],
      "@dataSnapshot/*": ["./src/features/dataSnapshot/*"],
      "@diskBrowser/*": ["./src/features/diskBrowser/*"],
      "@docAnalysis/*": ["./src/features/docAnalysis/*"],
      "@docNavigation/*": ["./src/features/docNavigation/*"],
      "@encryption/*": ["./src/features/encryption/*"],
      "@everythingSearch/*": ["./src/features/everythingSearch/*"],
      "@flashcardReading/*": ["./src/features/flashcardReading/*"],
      "@floatingBox/*": ["./src/features/floatingBox/*"],
      "@floatingToolbar/*": ["./src/features/floatingToolbar/*"],
      "@formatAssistant/*": ["./src/features/formatAssistant/*"],
      "@generalSettings/*": ["./src/features/generalSettings/*"],
      "@gitPush/*": ["./src/features/gitPush/*"],
      "@htmlViewer/*": ["./src/features/htmlViewer/*"],
      "@imageCompressor/*": ["./src/features/imageCompressor/*"],
      "@imageCreation/*": ["./src/features/imageCreation/*"],
      "@pageLock/*": ["./src/features/pageLock/*"],
      "@passwordVault/*": ["./src/features/passwordVault/*"],
      "@prompts/*": ["./src/features/prompts/*"],
      "@quickNote/*": ["./src/features/quickNote/*"],
      "@resourceManager/*": ["./src/features/resourceManager/*"],
      "@rssReader/*": ["./src/features/rssReader/*"],
      "@s3Backup/*": ["./src/features/s3Backup/*"],
      "@s3FileManager/*": ["./src/features/s3FileManager/*"],
      "@scriptLauncher/*": ["./src/features/scriptLauncher/*"],
      "@shortcut/*": ["./src/features/shortcut/*"],
      "@skillLearning/*": ["./src/features/skillLearning/*"],
      "@skillsViewer/*": ["./src/features/skillsViewer/*"],
      "@statistics/*": ["./src/features/statistics/*"],
      "@statusBar/*": ["./src/features/statusBar/*"],
      "@superPanel/*": ["./src/features/superPanel/*"],
      "@tableOfContents/*": ["./src/features/tableOfContents/*"],
      "@textDiff/*": ["./src/features/textDiff/*"],
      "@themeColor/*": ["./src/features/themeColor/*"],
      "@toolCollection/*": ["./src/features/toolCollection/*"],
      "@video/*": ["./src/features/video/*"],
      "@websiteNavigation/*": ["./src/features/websiteNavigation/*"]
    },
    "resolveJsonModule": true,
    "types": [
      "node",
      "vite/client",
      "siyuan"
    ],
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    /* Linting */
    "strict": false,
    "strictNullChecks": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "importHelpers": true,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ],
  "include": [
    "tools/**/*.ts",
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue"
  ],
  "exclude": [
    "node_modules",
    "src/abandon"
  ],
  "root": "."
}
